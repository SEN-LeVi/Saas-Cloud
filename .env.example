# ─── PostgreSQL ─────────────────────────────────────────────
# DBeaver: New Connection → PostgreSQL
#   Host: localhost   Port: 5432   Database: saas_cloud
#   Username: postgres   Password: postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_cloud?schema=public"

# ─── Better Auth ────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-with: npx @better-auth/cli secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OpenRouter (AI assistant) ──────────────────────────────
# Put your real key in .env.local (git-ignored), not here. Get one at https://openrouter.ai/keys
# The assistant only uses the 3 free models listed in src/lib/ai-models.ts.
OPENROUTER_API_KEY=YOUR_API_KEY_HERE
